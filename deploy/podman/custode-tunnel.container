[Unit]
Description=Custode tunnel Cloudflare
After=custode-web.service
Requires=custode-web.service

[Container]
# Versione fissata: aggiornarla a mano dopo aver letto le note di rilascio.
Image=docker.io/cloudflare/cloudflared:2026.11.0
Pod=custode.pod
ContainerName=custode-tunnel
Exec=tunnel --no-autoupdate run
# Il token arriva solo dal secret Podman: mai su file, argomenti o log.
Secret=custode-tunnel-token,type=env,target=TUNNEL_TOKEN

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
