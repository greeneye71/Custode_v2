[Unit]
Description=Diagnosi periodica di Custode
# Solo ordinamento. Nessuna dipendenza che attivi custode-web:
# un'app fermata di proposito deve restare ferma.
After=custode-web.service

[Service]
Type=oneshot
# A container assente (app ferma) l'esecuzione viene saltata: l'unità non fallisce.
ExecCondition=/usr/bin/podman container exists custode-web
# Esce con 1 se la diagnosi trova errori: l'unità risulta fallita.
ExecStart=/usr/bin/podman exec custode-web python3 /app/manutenzione.py diagnosi
